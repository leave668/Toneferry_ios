{
  "name": "toneferry",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "description": "Toneferry — WASAPI loopback → WebSocket → H5 AudioWorklet (PC audio to phone)",
  "scripts": {
    "build:capture": "capture\\build.bat",
    "build:exe": "node scripts/build-exe.mjs",
    "build": "npm run build:capture && npm run build:player && npm run build:exe",
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build:player": "go build -C host -ldflags \"-s -w\" -o ../bin/audio-play.exe ./player",
    "build:host": "go build -C host -ldflags \"-s -w -H=windowsgui\" -o ../release/Toneferry.exe ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.1",
    "esbuild": "^0.25.9",
    "resedit": "^3.1.0"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "release"
  }
}
